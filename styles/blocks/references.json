{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "References",
	"slug": "references",
	"blockTypes": ["core/list"],
	"styles": {
		"spacing": {
			"margin": {
				"left": "0"
			},
			"padding": {
				"left": "0"
			}
		},
		"typography": {
			"fontSize": "max(0.85rem,12px)",
			"lineHeight": "var:custom|line-height|snug"
		},
		"css": "list-style:none;& li{padding-left:1.5rem;text-indent:-1.5rem;margin-bottom:0.6rem;color:var(--wp--preset--color--bone)}& li a{overflow-wrap:break-word}"
	}
}
