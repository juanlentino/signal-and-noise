{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "signal-noise/pillar-essays",
	"title": "Pillar Essays",
	"category": "signal-noise",
	"icon": "excerpt-view",
	"description": "Owner-placeable rail of pillar essays derived from published Pages flagged with the plugin's _sn_pillar meta. Renders nothing when no pillars exist.",
	"keywords": [
		"pillar",
		"essays",
		"rail",
		"provenance"
	],
	"textdomain": "signal-noise",
	"supports": {
		"html": false
	},
	"attributes": {
		"compact": {
			"type": "boolean",
			"default": false
		},
		"headingLevel": {
			"type": "integer",
			"default": 2,
			"enum": [
				2,
				3,
				4
			]
		}
	},
	"editorScript": "signal-noise-blocks-editor",
	"render": "file:./render.php",
	"style": "file:./style.css"
}
