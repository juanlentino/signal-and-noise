{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"viewport": {
			"mobile": "480px",
			"tablet": "781px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "void",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "asphalt",
					"color": "#f5f5f5",
					"name": "Smoke"
				},
				{
					"slug": "concrete",
					"color": "#d9d9d9",
					"name": "Concrete"
				},
				{
					"slug": "rust",
					"color": "#666666",
					"name": "Steel"
				},
				{
					"slug": "bone",
					"color": "#000000",
					"name": "Black"
				},
				{
					"slug": "blood",
					"color": "#e00404",
					"name": "Red"
				},
				{
					"slug": "signal",
					"color": "#ff4c47",
					"name": "Signal"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"textIndent": true,
			"fontFamilies": [
				{
					"fontFamily": "'Bebas Neue', Impact, sans-serif",
					"name": "Bebas Neue",
					"slug": "heading",
					"fontFace": [
						{
							"fontFamily": "Bebas Neue",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/bebas-neue-latin.woff2"]
						}
					]
				},
				{
					"fontFamily": "'DM Mono', 'Courier New', monospace",
					"name": "DM Mono",
					"slug": "body",
					"fontFace": [
						{
							"fontFamily": "DM Mono",
							"fontWeight": "300",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/dm-mono-300-latin.woff2"]
						},
						{
							"fontFamily": "DM Mono",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/dm-mono-400-latin.woff2"]
						},
						{
							"fontFamily": "DM Mono",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/dm-mono-500-latin.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.8125rem", "name": "Small" },
				{ "slug": "medium", "size": "1.25rem", "name": "Medium" },
				{ "slug": "large", "size": "2.25rem", "name": "Large" },
				{ "slug": "x-large", "size": "2.625rem", "name": "Extra Large" },
				{ "slug": "xx-large", "size": "6rem", "name": "Huge", "fluid": { "min": "3rem", "max": "6rem" } },
				{ "slug": "xxx-large", "size": "9rem", "name": "Massive", "fluid": { "min": "4rem", "max": "9rem" } },
				{ "slug": "eyebrow", "size": "0.75rem", "name": "Eyebrow", "fluid": false },
				{ "slug": "eyebrow-lg", "size": "0.85rem", "name": "Eyebrow Large", "fluid": false },
				{ "slug": "prose", "size": "1rem", "name": "Prose" },
				{ "slug": "caption", "size": "0.9rem", "name": "Caption" },
				{ "slug": "display-sm", "size": "2.5rem", "name": "Display Small", "fluid": { "min": "1.8rem", "max": "2.5rem" } },
				{ "slug": "display-md", "size": "2.8rem", "name": "Display Medium", "fluid": { "min": "2rem", "max": "2.8rem" } },
				{ "slug": "display-lg", "size": "5rem", "name": "Display Large", "fluid": { "min": "2.5rem", "max": "5rem" } },
				{ "slug": "nav", "size": "1.125rem", "name": "Navigation" },
				{ "slug": "prose-lg", "size": "1.15rem", "name": "Prose Large" }
			]
		},
		"spacing": {
			"spacingScale": { "steps": 0 },
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "size": "0.3rem", "name": "Tight" },
				{ "slug": "20", "size": "0.44rem", "name": "Small" },
				{ "slug": "30", "size": "0.67rem", "name": "Regular" },
				{ "slug": "40", "size": "1rem", "name": "Medium" },
				{ "slug": "50", "size": "1.5rem", "name": "Large" },
				{ "slug": "60", "size": "2.25rem", "name": "XL" },
				{ "slug": "70", "size": "3.38rem", "name": "XXL" },
				{ "slug": "80", "size": "5.06rem", "name": "Huge" }
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"dimensions": {
			"width": true,
			"height": true,
			"dimensionSizes": [
				{ "slug": "hairline", "size": "1px", "name": "Hairline" },
				{ "slug": "short", "size": "20rem", "name": "Short" },
				{ "slug": "medium", "size": "32rem", "name": "Medium" },
				{ "slug": "tall", "size": "48rem", "name": "Tall" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1400px"
		},
		"custom": {
			"lineHeight": {
				"tight": 1.1,
				"normal": 1.7,
				"snug": 1.6,
				"loose": 1.8,
				"flat": 1,
				"display": 1.02
			},
			"letterSpacing": {
				"tight": "-0.02em",
				"wide": "0.15em",
				"snug": "-0.01em",
				"displayTight": "-0.03em"
			},
			"air": {
				"xxs": "clamp(0.85rem, 1.6vw, 1.15rem)",
				"xs": "clamp(1rem, 2vw, 1.5rem)",
				"sm": "clamp(1.5rem, 3vw, 2.25rem)",
				"md": "clamp(1.5rem, 3vw, 2.5rem)",
				"lg": "clamp(2rem, 4vw, 3rem)",
				"xl": "clamp(2.5rem, 5vw, 4rem)",
				"xxl": "clamp(2.5rem, 6vw, 5rem)"
			},
			"padPage": "var(--wp--custom--air--xxl) clamp(1.25rem, 4vw, 3rem) clamp(4rem, 8vw, 7rem)",
			"fontSize": {
				"micro": "0.7rem",
				"displayXs": "clamp(1.5rem, 3vw, 2.5rem)",
				"displayXl": "clamp(3rem, 7vw, 5.5rem)",
				"displayXxl": "clamp(3rem, 9vw, 7rem)",
				"displayHero": "clamp(5rem, 15vw, 12rem)",
				"pageItem": "clamp(0.95rem, 1.4vw, 1.05rem)",
				"pageDek": "clamp(1rem, 1.4vw, 1.15rem)",
				"pageSectionLabel": "clamp(1.4rem, 3vw, 2rem)",
				"pageHeadline": "clamp(3rem, 8vw, 7rem)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--void)",
			"text": "var(--wp--preset--color--bone)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7",
			"fontWeight": "300"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "400",
					"lineHeight": "var(--wp--custom--line-height--tight)",
					"textTransform": "uppercase"
				},
				"color": {
					"text": "var(--wp--preset--color--bone)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"letterSpacing": "var(--wp--custom--letter-spacing--tight)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"letterSpacing": "var(--wp--custom--letter-spacing--snug)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--blood)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--bone)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus-visible": {
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--blood)",
						"offset": "3px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--bone)",
					"text": "var(--wp--preset--color--void)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"textTransform": "uppercase",
					"letterSpacing": "var(--wp--custom--letter-spacing--wide)"
				},
				"border": {
					"radius": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "2rem",
						"right": "2rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--blood)",
						"text": "var(--wp--preset--color--void)"
					}
				},
				":focus-visible": {
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--blood)",
						"offset": "3px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "max(0.75rem, 11px)",
					"textTransform": "uppercase",
					"letterSpacing": "0.1em"
				},
				"color": {
					"text": "var(--wp--preset--color--rust)"
				}
			},
			"cite": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "max(0.75rem, 11px)",
					"textTransform": "uppercase",
					"letterSpacing": "0.1em"
				},
				"color": {
					"text": "var(--wp--preset--color--rust)"
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--concrete)"
				},
				"border": {
					"width": "1px",
					"color": "var(--wp--preset--color--concrete)"
				},
				"css": "opacity:0.6"
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--blood)",
						"width": "3px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--30)"
					}
				},
				"typography": {
					"fontStyle": "normal"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--void)",
					"text": "var(--wp--preset--color--blood)"
				},
				"border": {
					"radius": "0px",
					"width": "1px",
					"color": "var(--wp--preset--color--concrete)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"textTransform": "uppercase",
					"letterSpacing": "var(--wp--custom--letter-spacing--wide)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "post-frontmatter", "title": "Note front matter", "area": "article" },
		{ "name": "post-closing", "title": "Note closing", "area": "article" }
	],
	"customTemplates": [
		{ "name": "page-about", "title": "About", "postTypes": ["page"] },
		{ "name": "page-services", "title": "Services", "postTypes": ["page"] },
		{ "name": "page-music", "title": "Music", "postTypes": ["page"] },
		{ "name": "page-contact", "title": "Contact", "postTypes": ["page"] },
		{ "name": "page-resume", "title": "Resume / CV", "postTypes": ["page"] },
		{ "name": "page-notes", "title": "Notes Index", "postTypes": ["page"] },
		{ "name": "page-provenance", "title": "Provenance Pillar", "postTypes": ["page"] },
		{ "name": "page-now", "title": "Now", "postTypes": ["page"] },
		{ "name": "page-uses", "title": "Uses", "postTypes": ["page"] },
		{ "name": "page-accessibility", "title": "Accessibility", "postTypes": ["page"] },
		{ "name": "page-personal", "title": "Personal", "postTypes": ["page"] }
	]
}
