# The tag archive IS the shipped theme. The self-updater pulls
# archive/refs/tags/<tag>.zip (GitHub's archive endpoint respects export-ignore),
# and .github/workflows/deploy.yml builds the same payload with `git archive`.
# Everything below is dev/CI-only and never belongs inside wp-content/themes on a
# live install. Repo contents are unaffected — this only shapes the export.
#
# v10.44.0: ported from the plugin's list (first live at its v9.42.0). tests/
# alone is 79 files / ~591 KB — every one of them shipped to production on every
# theme update, for no reason. docs/ adds ~170 KB more.
#
# SAFETY: verified by tokenizing every runtime PHP file (comments stripped —
# grep alone reports false hits, and did) that NO runtime code references any
# path below. manifest ∩ runtime = ∅. Never widen this list blindly; re-run that
# check if you do.
tests/            export-ignore
.github/          export-ignore
docs/             export-ignore
CHANGELOG.md      export-ignore
composer.json     export-ignore
phpstan-bootstrap.php export-ignore
phpstan.neon          export-ignore
phpstan-baseline.neon export-ignore
phpcs.xml.dist    export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore
.gitleaks.toml    export-ignore
.pre-commit-config.yaml export-ignore
